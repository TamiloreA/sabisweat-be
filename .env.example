# Server
PORT=4000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-secret-key
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Direct Database Connection (for migrations)
SUPABASE_DB_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Notifications & Email (Optional for testing, required for production delivery)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=SabiSweat <notifications@sabisweat.com>
EXPO_ACCESS_TOKEN=your_expo_access_token

# Push Notification Images — User Avatars & Streak Images (Optional)
# Base URL for the Supabase project hosting media assets (avatars, streaks).
# Defaults to https://auth.sabisweat.com if not set.
SUPABASE_MEDIA_URL=https://auth.sabisweat.com

# Supabase Storage bucket names (defaults shown)
AVATAR_BUCKET=avatar2
STREAKS_BUCKET=streaks

# Streak notification images — set these when streak images are uploaded
# Option A: Supabase Storage base URL (images resolved by event name)
# STREAK_STORAGE_BASE_URL=https://auth.sabisweat.com/storage/v1/object/public/streaks

# Option B: Individual CDN URLs per streak event
# CDN_STREAK_FLAME_CELEBRATION=https://your-cdn.com/streak-celebration.png
# CDN_STREAK_FLAME_ACTIVE=https://your-cdn.com/streak-active.png
# CDN_STREAK_FLAME_URGENT=https://your-cdn.com/streak-at-risk.png
